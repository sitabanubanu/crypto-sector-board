# Use a pooled PostgreSQL connection string in Vercel/serverless environments.
# Neon and other Vercel Marketplace providers can inject this value.
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_sector_board

# Optional legacy Vercel-compatible fallback. DATABASE_URL takes precedence.
# POSTGRES_URL=postgresql://user:password@localhost:5432/crypto_sector_board

# Keep the pool small in serverless processes. Allowed range: 1-10.
DATABASE_POOL_MAX=1

# P4 read-path switch. Use json to roll the page back without touching DB data.
DATA_BACKEND=db

# In DB mode, compare the returned board with the latest validated JSON snapshot.
# JSON rollback mode always bypasses the database, regardless of this value.
DATA_DUAL_READ=true

# P3 ingestion windows in hours. Defaults shown below.
INGEST_INITIAL_BACKFILL_HOURS=24
INGEST_REPAIR_LOOKBACK_HOURS=24
INGEST_MAX_BACKFILL_HOURS=168

# One-off only: scan and backfill a deeper historical window without deleting
# existing rows. Leave unset in scheduled ingestion.
# INGEST_HISTORY_BACKFILL_HOURS=744

# Optional CoinGecko Pro key. Keep it server-side only.
# COINGECKO_API_KEY=
