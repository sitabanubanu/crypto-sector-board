{
  "name": "crypto-sector-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/db-migration.test.ts tests/ingestion.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:import-legacy": "tsx scripts/import-legacy-snapshots.ts",
    "ingest-market-data": "tsx scripts/ingest-market-data.ts",
    "data:health": "tsx scripts/data-health.ts",
    "registry:check": "tsx scripts/check-registry.ts",
    "registry:verify": "tsx scripts/verify-provider-mappings.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all-policy": "node scripts/check-audit-policy.mjs",
    "check": "npm run lint && npm run typecheck && npm run registry:check && npm run db:check && npm test && npm run audit:prod && npm run audit:all-policy && npm run build",
    "fetch-snapshot": "tsx scripts/fetch-snapshot.ts",
    "telegram-push": "tsx scripts/send-telegram.ts"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "2.4.2",
    "undici": "8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@next/env": "16.2.12",
    "@tailwindcss/postcss": "^4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "global-agent": "^4.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  }
}
